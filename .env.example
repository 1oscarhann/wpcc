# Copy to .env (never commit .env). Every value has a sensible local default.

# Postgres. Paste Neon's connection string as-is; it's normalised for asyncpg automatically.
# Local dev default: the cluster from README "Local Postgres" (port 5433, user hf, trust auth).
DATABASE_URL=postgresql+asyncpg://hf@127.0.0.1:5433/hearthforge

# dev | prod
HF_ENV=dev
# Comma-separated list of allowed frontend origins (CORS + Origin check).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Secure cookies need HTTPS. Keep false for http://localhost, true in production.
COOKIE_SECURE=false
# Only set in production when the API is on a subdomain, e.g. .example.com (PLAN B2).
COOKIE_DOMAIN=
# Run the timer worker inside the API process (cheaper hosting; see PLAN §1.2).
RUN_WORKER_IN_PROCESS=false
# Where /config lives (default: repo root /config).
# HF_CONFIG_DIR=/path/to/config
HF_CONFIG_STRICT=false
